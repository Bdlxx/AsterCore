<?xml version="1.0" encoding="utf-8"?>
<!--
  栖星 AsterCore · .NET Framework 运行时配置（必须放在 astercore.exe **同级**）

  为什么需要这个文件（真机 v0.3.0 逐层排查的结论）：
  Windows 上 pywebview 的内嵌窗口走 pythonnet + clr_loader（.NET Framework / netfx 路径）。
  pythonnet 用 Assembly.LoadFrom 加载包内的 pythonnet\runtime\Python.Runtime.dll。
  只要 .NET 认为该程序集**来自"网络位置"**（浏览器下载的 zip 解压后带 MOTW /
  Zone.Identifier；或被投影/虚拟文件系统托管，例如本机工作区），LoadFrom 就会抛
  System.IO.FileLoadException (HRESULT 0x80131515)，内层是 NotSupportedException
  "尝试从一个网络位置加载程序集…请启用 loadFromRemoteSources 开关"。

  而这个异常被 clr_loader 的原生 shim 吞掉了，现场只看到：
      WARNING astercore.shell: pywebview 启动失败，回退浏览器:
        Failed to resolve Python.Runtime.Loader.Initialize from …\Python.Runtime.dll
  于是"桌面版"静默退化成开浏览器、托盘也不建 —— 极难定位。

  打开这个开关后：内嵌窗口正常、点 X 隐藏到托盘。CI 会把本文件复制到
  dist/astercore/astercore.exe.config（PyInstaller 的 datas 只会进 _internal，
  而 .NET 只认 <exe 名>.config 且必须在 exe 同级，所以必须单独拷）。
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- 关键：允许 LoadFrom 加载被判为"网络位置"的程序集（pythonnet/clr_loader） -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
